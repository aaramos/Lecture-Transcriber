{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lecture Processor",
  "version": "0.5.0",
  "identifier": "com.aaramos.lectureprocessor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lecture Processor",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": [
      "../.tools/darwin_arm64/ffmpeg",
      "../.tools/darwin_arm64/ffprobe",
      "../pyproject.toml",
      "../README.md",
      "../src/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
