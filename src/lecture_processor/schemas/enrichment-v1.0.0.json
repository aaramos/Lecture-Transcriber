{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecture-processor.local/schemas/enrichment-v1.0.0.json",
  "title": "Lecture AI Enrichment",
  "type": "object",
  "required": [
    "schema_version", "provider", "model", "started_at", "finished_at",
    "title", "executive_summary", "formatted_transcript", "outline", "slide_analysis", "resources", "warnings",
    "step_timings", "step_token_usage"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.\\d+\\.\\d+$"},
    "provider": {"type": "string", "enum": ["anthropic", "gemini", "grok", "mock", "lm-studio", "experimental-routing"]},
    "model": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "input_token_estimate": {"type": "integer", "minimum": 0},
    "output_token_estimate": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "executive_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "formatted_transcript": {"type": "string", "minLength": 1, "maxLength": 50000},
    "outline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "heading", "slide_ids"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "heading": {"type": "string", "minLength": 1, "maxLength": 200},
          "slide_ids": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "slide_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_id", "descriptive_filename", "caption", "summary", "tags", "instructor_commentary"],
        "additionalProperties": false,
        "properties": {
          "slide_id": {"type": "integer", "minimum": 1},
          "descriptive_filename": {"type": ["string", "null"], "maxLength": 200},
          "caption": {"type": ["string", "null"], "maxLength": 1000},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "tags": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 40},
            "maxItems": 10
          },
          "instructor_commentary": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url", "summary", "source_quality"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "url": {"type": "string", "format": "uri"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500},
          "source_quality": {"type": "string", "enum": ["high", "medium"]}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "step_timings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["started_at", "elapsed_seconds"],
        "additionalProperties": true,
        "properties": {
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "elapsed_seconds": {"type": "number", "minimum": 0}
        }
      }
    },
    "step_token_usage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["input_tokens", "output_tokens", "total_tokens"],
        "additionalProperties": false,
        "properties": {
          "input_tokens": {"type": "integer", "minimum": 0},
          "output_tokens": {"type": "integer", "minimum": 0},
          "total_tokens": {"type": "integer", "minimum": 0}
        }
      }
    },
    "step_outcomes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["outcome", "message"],
        "additionalProperties": false,
        "properties": {
          "outcome": {"type": "string", "enum": ["success", "fallback", "skipped", "metadata_used"]},
          "message": {"type": "string"}
        }
      }
    }
  }
}
